# MaintainerOS data mode
MAINTAINEROS_OFFLINE_MODE=true
MAINTAINEROS_DATA_MODE=fixture
MAINTAINEROS_DEMO_REPO_ID=vercel/next.js
MAINTAINEROS_LIVE_TIMEOUT_MS=1200
MAINTAINEROS_POSTGRES_CONNECTION_TIMEOUT_MS=3000

# Neon Postgres
# Owner/admin URL for server-side migrations/import jobs.
DATABASE_URL=
# Optional authenticated-role URL if Neon Auth/RLS is enabled.
DATABASE_AUTHENTICATED_URL=

# Neon Auth, only needed if auth is enabled.
AUTH_ENABLED=false
AUTH_BYPASS_DEV=false
NEON_AUTH_ENABLED=false
MAINTAINEROS_WORKFLOW_API_TOKEN=
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# GitHub import
GITHUB_TOKEN=
GITHUB_IMPORT_OWNER=vercel
GITHUB_IMPORT_REPO=next.js
GITHUB_IMPORT_LIMIT=40
GITHUB_DEMO_REPOS=vercel/next.js,obro79/maintaineros-demo-ledgerkit,obro79/maintaineros-demo-hooksmith

# Public GitHub OAuth connect flow
# The connect UI uses OAuth only for public sign-in and does not request broad repo scope.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3010/api/auth/github/callback

# Hourly GitHub import polling
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to the cron route.
CRON_SECRET=

# CLOD model router
CLOD_API_KEY=
CLOD_BASE_URL=https://api.clod.io/v1
CLOD_CHEAP_MODEL=DeepSeek V3
CLOD_BALANCED_MODEL=GPT 4o
CLOD_DEEP_MODEL=DeepSeek V3
CLOD_TIMEOUT_MS=12000

# AI PR creation
# daytona uses the hosted sandbox; local uses this machine's git + gh/GITHUB_TOKEN.
MAINTAINEROS_AGENT_EXECUTION_MODE=daytona

# Sponsor/live-shaped adapters
GREPTILE_API_KEY=
CLUSTLY_AGENT_KEY=
CLUSTLY_BASE_URL=https://clustly.ai/api/v1
CLUSTLY_AGENT_ID=
NIA_API_KEY=
NIA_BASE_URL=
DAYTONA_API_KEY=
DAYTONA_BASE_URL=
DAYTONA_ORG_ID=

# Demo controls
NEXT_PUBLIC_MAINTAINEROS_DEMO_AUTOPLAY=true
NEXT_PUBLIC_MAINTAINEROS_FORCE_FIXTURES=false

# MaintainerOS SaaS billing, disabled unless BILLING_ENABLED=true.
BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3010
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
